{
  "name": "Custom Website Blocker",
  "description": "Block websites you choose.",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
  {
    "resources": ["image/404-cat.jpg", "blocked.html"],
    "matches": ["<all_urls>"]
  }
]
}
